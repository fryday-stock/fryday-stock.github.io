rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // يسمح فقط للأجهزة اللي فتحت الموقع (دخول مجهول عبر Firebase Auth)
    match /{collection}/{doc} {
      allow read, write: if request.auth != null
        && collection in ['items', 'locations', 'staff', 'moves', 'stocktakes'];
    }
  }
}
